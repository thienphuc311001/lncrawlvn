# Google AI Studio API key (backend only)
GOOGLE_AI_API_KEY=
# Optional second key, tried on quota errors before changing models
GOOGLE_AI_API_KEY_BACKUP=
# Optional third key, rotated with the same quota and cooldown rules
GOOGLE_AI_API_KEY_THIRD=
# Optional additional keys, comma-separated (duplicates are ignored)
GOOGLE_AI_API_KEYS=

# Translation workers: 1–3
TRANSLATION_WORKERS=2

# Address/title register for character reference forms.
#   sino-vietnamese (default) keeps the novel's established Sino-Vietnamese style
#   modern                   expects modern conversational Vietnamese
#   auto                     derives the register from confirmed terminology
# TRANSLATION_DICTIONARY_REGISTER=sino-vietnamese
# Evidence needed before "auto" trusts the confirmed style (defaults 2 and 0.6)
# TRANSLATION_DICTIONARY_REGISTER_MIN_EVIDENCE=2
# TRANSLATION_DICTIONARY_REGISTER_MIN_DOMINANCE=0.6

# Dictionary resolution policy (defaults 3, 0.95, 0.95)
# TRANSLATION_DICTIONARY_MIN_CONTEXTS=3
# TRANSLATION_DICTIONARY_MIN_DOMINANCE=0.95
# TRANSLATION_DICTIONARY_MIN_COVERAGE=0.95
