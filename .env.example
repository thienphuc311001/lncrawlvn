# Gemini credentials (server only)
GOOGLE_AI_API_KEY=
GOOGLE_AI_API_KEY_BACKUP=
GOOGLE_AI_API_KEY_THIRD=
# Optional comma-separated additional keys
GOOGLE_AI_API_KEYS=

# RAW Chinese to Vietnamese translation
TRANSLATION_WORKERS=2
TRANSLATION_RETRIES_PER_PAIR=2
TRANSLATION_MAX_RAW_CHARS=9000
TRANSLATION_MAX_ESTIMATED_OUTPUT_TOKENS=12000
TRANSLATION_MIN_LENGTH_RATIO=0.30
TRANSLATION_AUTHOR_NOTE_POLICY=preserve
# Anomaly warning and hard guard scale with chapter count if omitted
# TRANSLATION_WARNING_LOGICAL_CALLS=20
# TRANSLATION_HARD_LOGICAL_CALLS=30
# TRANSLATION_HARD_API_ATTEMPTS=60
# Optional model thinking budget (omit for model default)
# TRANSLATION_THINKING_BUDGET=
# Optional private request snapshots; never stores API secrets
# TRANSLATION_DEBUG_SNAPSHOTS=1
