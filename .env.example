# Google AI Studio API key (backend only)
GOOGLE_AI_API_KEY=
# Optional second key, tried on quota errors before changing models
GOOGLE_AI_API_KEY_BACKUP=
# Optional third key, rotated with the same quota and cooldown rules
GOOGLE_AI_API_KEY_THIRD=
# Optional additional keys, comma-separated (duplicates are ignored)
GOOGLE_AI_API_KEYS=

# Translation workers: 1–3
TRANSLATION_WORKERS=2
